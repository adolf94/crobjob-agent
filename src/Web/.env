# Frontend environment (placeholders — replace with real Atlas Rig client values after registration)
VITE_AR_AUTH_AUTHORITY=https://auth.adolfrey.com/api
VITE_AR_AUTH_CLIENT_ID=cron-agent-ui
# Note: the OIDC redirect URI is derived at runtime from the app root
# (APP_ROOT) — http://localhost:5173/callback in dev — so it is not set here.
VITE_AR_AUTH_SCOPE=openid profile email api:\\cron-agent\user
