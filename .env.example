# homelab-cron-agent — compose .env
# Copy to the deploy dir (/srv/deploy/cron-agent/.env) and edit there.
# Compose auto-loads this file for ${...} interpolation; the service also
# inherits it via env_file. Every var is optional — leave commented to use
# the inline defaults in docker-compose.yml.

# ── Atlas Rig OIDC ────────────────────────────────────────────────────────────
# Auth disabled by default until the client is registered. To enable:
# set AUTH_DISABLED=false, fill the scope, and push a rebuild with real
# VITE_AR_AUTH_* build args (SPA values are baked at docker build time).
#AUTH_DISABLED=false
#AUTH_AUTHORITY=https://auth.adolfrey.com/api
#AUTH_REQUIRED_SCOPES=
# Accepted JWT audiences (space-separated). Empty = skip audience validation
# (issuer + signature are still checked). Set to the token's aud claim
# (e.g. cron-agent-ui) for strict checking.
#AUTH_AUDIENCE=

# Confidential client for outbound client_credentials dispatches (arauth jobs).
# Leave empty to keep dispatches anonymous / function-key based;
# set BOTH to enable bearer-token dispatch.
#AUTH_CLIENT_ID=
#AUTH_CLIENT_SECRET=

# ── Scheduler tuning ─────────────────────────────────────────────────────────
#SCHEDULER_POLL_SECONDS=15
#SCHEDULER_HTTP_TIMEOUT_SECONDS=60
#SCHEDULER_RETRY_BASE_DELAY_MS=5000

# ── Alerts ───────────────────────────────────────────────────────────────────
# Optional alert webhook (e.g. ntfy/Discord). Empty = disabled.
#ALERTS_WEBHOOK_URL=
